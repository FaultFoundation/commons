{
  "name": "commons",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "next lint",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply website-sql --local",
    "db:migrate:remote": "wrangler d1 migrations apply website-sql --remote",
    "db:import:legacy": "node scripts/migrate-legacy-bot-data.mjs",
    "db:cen:generate": "drizzle-kit generate --config drizzle.cen.config.ts",
    "db:cen:migrate:local": "wrangler d1 migrations apply cen-sql --local",
    "db:cen:migrate:remote": "wrangler d1 migrations apply cen-sql --remote",
    "db:ow:generate": "drizzle-kit generate --config drizzle.ow.config.ts",
    "db:ow:migrate:local": "wrangler d1 migrations apply ow-player-data --local",
    "db:ow:migrate:remote": "wrangler d1 migrations apply ow-player-data --remote",
    "cen:project": "node scripts/cen-project.mjs",
    "discord:role-metadata": "node scripts/register-role-metadata.mjs",
    "staff:seed": "node scripts/seed-staff-owner.mjs",
    "schedule:seed": "node scripts/seed-schedule.mjs",
    "schedule:probe": "node scripts/probe-providers.mjs",
    "db:seed:generate": "node scripts/gen-schools-seed.mjs",
    "db:seed:local": "wrangler d1 execute website-sql --local --file=db/seed/schools.sql",
    "db:seed:remote": "wrangler d1 execute website-sql --remote --file=db/seed/schools.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "next": "^15.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-avatar-editor": "^15.1.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260710.1": true,
    "sharp@0.34.5": true,
    "esbuild@0.18.20": true
  }
}
