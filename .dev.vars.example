# Copy to .dev.vars (gitignored) for local dev/preview.
# Production values live in Workers Secrets (`wrangler secret put NAME`) and
# wrangler.jsonc "vars" — see docs/cloudflare-setup.md.

# Any long random string locally; production: openssl rand -base64 32
#
# Not just a session key: it also encrypts every member's TOTP secret and
# backup codes (the `two_factor` table). Changing it locks enrolled members out
# of two-factor sign-in for good — see docs/cloudflare-setup.md before you
# rotate it anywhere real.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The origin the app is served from. 3999 = `npm run preview` (wrangler dev);
# plain `next dev` on :3000 is also trusted in development.
BETTER_AUTH_URL=http://localhost:3999

# Optional — enables the "Continue with Discord" button locally. Create/reuse
# a Discord application and add http://localhost:3999/api/auth/callback/discord
# as an OAuth2 redirect.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Optional — the Fault Foundation server's snowflake. Set it and the account
# page shows whether the member has actually joined the Discord (needs the
# guilds.members.read scope, which is requested at link time). Production
# reads it from wrangler.jsonc "vars" instead; it isn't a secret.
# DISCORD_GUILD_ID=

# Optional — JSON map of Discord role snowflake -> staff tier
# (owner|admin|moderator|tournament_admin). Members holding a mapped role are
# auto-granted that tier (granted_via="discord") when they open the admin area,
# and lose it when the Discord role is removed. Manual grants made in the
# dashboard are never touched. Bootstrap the first owner with
# `node scripts/seed-staff-owner.mjs`. Not a secret.
# DISCORD_STAFF_ROLE_MAP={"111111111111111111":"admin","222222222222222222":"moderator"}

# Optional — enables the Blizzard "Connect" button locally. Create a client at
# https://develop.battle.net/access/clients and add
# http://localhost:3999/api/auth/oauth2/callback/battlenet as a redirect URI
# (note the /oauth2/ segment — generic-OAuth providers use a different callback
# path than Discord's). Link-only: Blizzard returns no email, so it can never
# create an account on its own.
# BATTLENET_CLIENT_ID=
# BATTLENET_CLIENT_SECRET=

# Optional — the 16-char Google app password for support@fault.foundation.
# Set it and real mail goes out (academic-email codes, account-email
# confirmation links, two-factor sign-in codes); leave it unset and the message
# body is printed to the server terminal instead, which is usually what you
# want locally. Only `npm run preview` (:3999, real workerd) can actually
# send — `next dev` runs in Node, which has no sockets.
# SUPPORT_EMAIL_APP_PASSWORD=

# Override the sending mailbox (defaults to support@fault.foundation) or the
# server (defaults to smtp.gmail.com:465, implicit TLS).
# SUPPORT_EMAIL=
# EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=

# Optional — shared secret for the Discord bot's calls to this site. The bot
# only ever calls outbound (opening tickets, mirroring messages, and polling
# /api/bot/outbox for staff replies / closes / transcripts to carry out), so
# nothing on the bot needs to be publicly reachable. Leave unset and the ticket
# dashboard still works (D1 is the source of truth); Discord just isn't wired up.
# BOT_API_SECRET=replace-with-a-long-random-string
