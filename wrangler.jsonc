// Cloudflare Workers config: Next.js on Workers via OpenNext
// (@opennextjs/cloudflare). `opennextjs-cloudflare build` emits the worker
// entry + prerendered assets into .open-next/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fault-foundation-db",
      // Placeholder until `wrangler d1 create fault-foundation-db` is run
      // (see docs/cloudflare-setup.md). Local dev/preview works as-is.
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "drizzle"
    }
  ],
  // Non-secret runtime config. Secrets (BETTER_AUTH_SECRET, DISCORD_*) are
  // set with `wrangler secret put` in production and .dev.vars locally.
  "vars": {
    "BETTER_AUTH_URL": "https://fault.foundation"
  },
  // Port 3999 so scripts/extract-text.mjs and screenshot-compare.mjs work
  // against `npm run preview` unchanged.
  "dev": {
    "port": 3999
  },
  "observability": {
    "enabled": true
  }
}
